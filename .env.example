# Copy to .env (gitignored) and fill in.
# Create the key in Garmin Connect web: Personal API Key page. It is shown only once.
GARMIN_PERSONAL_API_KEY=
# Optional: key expiry date (YYYY-MM-DD) for advance warnings.
GARMIN_API_KEY_EXPIRES=

# Defaults suit local runs against the compose database; docker compose sets its own.
# DATABASE_URL=postgresql+psycopg://garminagent:garminagent@127.0.0.1:5432/garminagent
# DATA_DIR=data
# LOG_LEVEL=INFO
# LOG_FORMAT=text
