# Copy to .env (gitignored) and fill in.
# Create the key in Garmin Connect web: Personal API Key page. It is shown only once.
GARMIN_PERSONAL_API_KEY=
# Optional: key expiry date (YYYY-MM-DD) for advance warnings.
GARMIN_API_KEY_EXPIRES=

# Database passwords for the compose stack (required; choose your own, e.g. `openssl rand -hex 24`).
# They are fixed when the database volume is first created; after changing them, recreate the
# volume with `docker compose down -v` (deletes local data).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# For running the CLI or tests outside Docker against the compose database, also set
# DATABASE_URL and MIGRATION_DATABASE_URL. Start from the defaults
#   postgresql+psycopg://garminagent_app@127.0.0.1:5432/garminagent   (app role)
#   postgresql+psycopg://garminagent@127.0.0.1:5432/garminagent       (schema owner)
# and insert ":<password>" after the user name, using the passwords above.
# DATA_DIR=data
# LOG_LEVEL=INFO
# LOG_FORMAT=text
