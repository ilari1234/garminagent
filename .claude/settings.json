{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(./data/**)",
      "Read(!./data/spike/*/report.json)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfplan)",
      "Read(**/tfplan)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(**/backend.hcl)",
      "Read(~/.aws/**)",
      "Bash(terraform *apply*)",
      "Bash(terraform *destroy*)",
      "Bash(terraform *plan*)",
      "Bash(terraform *refresh*)",
      "Bash(terraform *state*)",
      "Bash(terraform *show*)",
      "Bash(terraform *output*)",
      "Bash(terraform *console*)",
      "Bash(terraform *import*)",
      "Bash(terraform *force-unlock*)",
      "PowerShell(terraform *apply*)",
      "PowerShell(terraform *destroy*)",
      "PowerShell(terraform *plan*)",
      "PowerShell(terraform *refresh*)",
      "PowerShell(terraform *state*)",
      "PowerShell(terraform *show*)",
      "PowerShell(terraform *output*)",
      "PowerShell(terraform *console*)",
      "PowerShell(terraform *import*)",
      "PowerShell(terraform *force-unlock*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hooks/guard_private_paths.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
