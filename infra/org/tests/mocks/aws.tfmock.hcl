  defaults = {
    arns               = ["arn:aws:sso:::instance/ssoins-0000000000000000"]
    identity_store_ids = ["d-0000000000"]
  }
}

mock_data "aws_identitystore_user" {
  defaults = {
    user_id = "00000000-0000-0000-0000-000000000000"
  }
}

